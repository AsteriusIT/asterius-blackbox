# ---------- Agent ----------
ANTHROPIC_API_KEY=sk-ant-...
# Step 1 — planner/lead (plans, delegates, reviews, opens PRs, deploys previews)
AGENT_PLANNER_MODEL=claude-opus-5-5
AGENT_PLANNER_EFFORT=high
# Step 2 — coder subagent (writes code & tests, commits, pushes)
AGENT_CODER_MODEL=claude-sonnet-5-5
AGENT_CODER_EFFORT=medium
# Share the plan and wait for the user's go before building
AGENT_REQUIRE_PLAN_APPROVAL=false
AGENT_MAX_BUDGET_USD=25
# Monthly budgets (USD) that pause new runs once reached; 0 = unlimited. Admins override per user/app (PUT /api/budgets)
# BUDGET_USER_MONTHLY_USD=0
# BUDGET_APP_MONTHLY_USD=0
# BUDGET_GLOBAL_MONTHLY_USD=0
# Platform admins: global audit log, costs and budgets
# ADMIN_EMAILS=alice@example.com
# Concurrency: cluster-wide and per-user caps on running agent sessions (others wait in the queue)
# AGENT_MAX_CONCURRENT_RUNS=4
# AGENT_MAX_RUNS_PER_USER=2
# Resume runs interrupted by a restart in the same agent session
# AGENT_RESUME_INTERRUPTED=false
# all (API + agents, default) | api | worker — split needs DATABASE_URL=postgres://…
# BLACKBOX_ROLE=all
# Housekeeping: drop tool-call activity of finished runs after N days; remove idle workspace clones (0 = never)
# EVENTS_RETENTION_DAYS=30
# WORKSPACE_GC_DAYS=14
AGENT_SANDBOX=true

# ---------- Platform ----------
PUBLIC_URL=http://localhost:5173
# Storage: empty = SQLite under DATA_DIR. Postgres for several replicas / worker pods:
# DATABASE_URL=postgres://blackbox:secret@localhost:5432/blackbox
# 32-byte key (base64/hex) encrypting app secrets set in the UI; generated under DATA_DIR if unset (single instance)
# SECRETS_KEY=
# Observability: GET /healthz (liveness), /readyz (DB critical; ADO/K8s/Anthropic reported), /metrics (Prometheus)
# METRICS_TOKEN=          # optional bearer token for /metrics
# Tracing (OpenTelemetry, OTLP/HTTP): agent.run → tool <name> → k8s.* / outgoing HTTP
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=asterius-blackbox

# ---------- Sign-in ----------
# local (email + password) and/or entra (Microsoft Entra ID SSO), comma-separated.
# `scripts/entra-app.sh` creates the app registration with the Azure CLI and fills the ENTRA_* values.
AUTH_PROVIDERS=local
ALLOW_REGISTRATION=true
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=        # default: ${PUBLIC_URL}/api/auth/entra/callback
# ---------- Port (getport.io) — see deploy/port/README.md ----------
# PORT_CLIENT_ID=
# PORT_CLIENT_SECRET=
# PORT_API_URL=https://api.port.io       # US: https://api.us.port.io
# PORT_SYNC_SERVICES=true
# PORT_DEFAULT_TEAM=
# PORT_AGENT_CONTEXT=true
# PORT_ACTIONS_ENABLED=false              # needs Port → Blackbox connectivity (execution agent or exposed webhook)

# Review loop: poll open PRs and let the agent address new reviewer comments / failing checks (0 = off)
# PR_FEEDBACK_POLL_SECONDS=120

# NOTIFY_WEBHOOK_URL=https://<teams-or-slack-incoming-webhook>

# ---------- Git: "local" (offline, bare repos + protected main), "azure-devops" or "github" ----------
GIT_PROVIDER=local
# ADO_ORG_URL=https://dev.azure.com/my-org
# ADO_PROJECT=Blackbox
# Platform identity: Code (Read, Write & Manage), Project & Team (Read), Build (Read & Execute)
# ADO_ADMIN_PAT=
# Agent identity: Code (Read & Write) ONLY. Must NOT have "Bypass policies when pushing"/"Force push".
# ADO_AGENT_GIT_PAT=
# ADO_MIN_REVIEWERS=1
# ADO_REQUIRED_REVIEWER_ID=<group or user descriptor id>
# ADO_BUILD_VALIDATION=true
# GitHub (GIT_PROVIDER=github): repos under GITHUB_OWNER, main protected by a ruleset, CI = GitHub Actions (job `ci`)
# GITHUB_OWNER=my-org
# GITHUB_ADMIN_TOKEN=     # platform: Administration + Contents + Pull requests (+ delete repos)
# GITHUB_AGENT_TOKEN=     # agent git push: Contents read/write only, not a ruleset bypass actor
# GITHUB_MIN_REVIEWERS=1

# ---------- Kubernetes test environments ----------
# Local cluster: run `scripts/local-cluster.sh up` and paste the settings it prints.
K8S_ENABLED=false
# kaniko (in-cluster, needs Azure DevOps) | docker (local Docker build, works with GIT_PROVIDER=local)
# K8S_BUILD_MODE=kaniko
# docker mode: push | kind | k3d | minikube | none (Docker Desktop / OrbStack / Rancher Desktop)
# K8S_IMAGE_LOAD=push
# K8S_LOCAL_CLUSTER_NAME=blackbox
# K8S_PUBLIC_PORT=          # ingress host port when not 80 (local clusters)
# K8S_REGISTRY_INSECURE=false
# KUBECONFIG_PATH=
# K8S_CONTEXT=
# K8S_IMAGE_REGISTRY=myregistry.azurecr.io/blackbox
# K8S_REGISTRY_PUSH_SECRET=registry-push
# K8S_REGISTRY_PULL_SECRET=
# K8S_BUILD_NAMESPACE=blackbox-builds
# K8S_BASE_DOMAIN=localtest.me   # production: preview.example.com
# K8S_INGRESS_CLASS=nginx
# K8S_INGRESS_NAMESPACE=ingress-nginx
# K8S_CLUSTER_ISSUER=letsencrypt
# K8S_ENV_TTL_HOURS=72
# K8S_ENV_MAX_TTL_DAYS=30   # cap when people extend a preview; pinned previews (and staging) never expire
# Preview egress: all | none | dns-only | allowlist (+ K8S_PREVIEW_EGRESS_ALLOWLIST=10.0.0.0/8,1.2.3.4/32)
# K8S_PREVIEW_EGRESS=all
