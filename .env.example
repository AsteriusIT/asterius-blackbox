# ---------- Agent ----------
ANTHROPIC_API_KEY=sk-ant-...
# Step 1 — planner/lead (plans, delegates, reviews, opens PRs, deploys previews)
AGENT_PLANNER_MODEL=claude-opus-5-5
AGENT_PLANNER_EFFORT=high
# Step 2 — coder subagent (writes code & tests, commits, pushes)
AGENT_CODER_MODEL=claude-sonnet-5-5
AGENT_CODER_EFFORT=medium
# Share the plan and wait for the user's go before building
AGENT_REQUIRE_PLAN_APPROVAL=false
AGENT_MAX_BUDGET_USD=25
AGENT_SANDBOX=true

# ---------- Platform ----------
PUBLIC_URL=http://localhost:5173

# ---------- Sign-in ----------
# local (email + password) and/or entra (Microsoft Entra ID SSO), comma-separated.
# `scripts/entra-app.sh` creates the app registration with the Azure CLI and fills the ENTRA_* values.
AUTH_PROVIDERS=local
ALLOW_REGISTRATION=true
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=        # default: ${PUBLIC_URL}/api/auth/entra/callback
# ---------- Port (getport.io) — see deploy/port/README.md ----------
# PORT_CLIENT_ID=
# PORT_CLIENT_SECRET=
# PORT_API_URL=https://api.port.io       # US: https://api.us.port.io
# PORT_SYNC_SERVICES=true
# PORT_DEFAULT_TEAM=
# PORT_AGENT_CONTEXT=true
# PORT_ACTIONS_ENABLED=false              # needs Port → Blackbox connectivity (execution agent or exposed webhook)

# NOTIFY_WEBHOOK_URL=https://<teams-or-slack-incoming-webhook>

# ---------- Git: "local" (offline, bare repos + protected main) or "azure-devops" ----------
GIT_PROVIDER=local
# ADO_ORG_URL=https://dev.azure.com/my-org
# ADO_PROJECT=Blackbox
# Platform identity: Code (Read, Write & Manage), Project & Team (Read), Build (Read & Execute)
# ADO_ADMIN_PAT=
# Agent identity: Code (Read & Write) ONLY. Must NOT have "Bypass policies when pushing"/"Force push".
# ADO_AGENT_GIT_PAT=
# ADO_MIN_REVIEWERS=1
# ADO_REQUIRED_REVIEWER_ID=<group or user descriptor id>
# ADO_BUILD_VALIDATION=true

# ---------- Kubernetes test environments ----------
# Local cluster: run `scripts/local-cluster.sh up` and paste the settings it prints.
K8S_ENABLED=false
# kaniko (in-cluster, needs Azure DevOps) | docker (local Docker build, works with GIT_PROVIDER=local)
# K8S_BUILD_MODE=kaniko
# docker mode: push | kind | k3d | minikube | none (Docker Desktop / OrbStack / Rancher Desktop)
# K8S_IMAGE_LOAD=push
# K8S_LOCAL_CLUSTER_NAME=blackbox
# K8S_PUBLIC_PORT=          # ingress host port when not 80 (local clusters)
# K8S_REGISTRY_INSECURE=false
# KUBECONFIG_PATH=
# K8S_CONTEXT=
# K8S_IMAGE_REGISTRY=myregistry.azurecr.io/blackbox
# K8S_REGISTRY_PUSH_SECRET=registry-push
# K8S_REGISTRY_PULL_SECRET=
# K8S_BUILD_NAMESPACE=blackbox-builds
# K8S_BASE_DOMAIN=localtest.me   # production: preview.example.com
# K8S_INGRESS_CLASS=nginx
# K8S_INGRESS_NAMESPACE=ingress-nginx
# K8S_CLUSTER_ISSUER=letsencrypt
# K8S_ENV_TTL_HOURS=72
